{
  "name": "cmumaps",
  "version": "0.0.0",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/bun": "^1.3.5",
    "@types/web": "^0.0.279",
    "markdownlint-cli2": "^0.20.0",
    "syncpack": "^13.0.4",
    "turbo": "^2.7.4",
    "typescript": "^5.9.3",
    "vite-plus": "^1.8.0"
  },
  "packageManager": "bun@1.3.5",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "check": "vp check",
    "db:populate": "cd apps/dataflow && secretspec run -P local -- uv run populate-database",
    "dev": "bun run dev:mobile",
    "dev:mobile": "turbo dev --filter=@cmumaps/mobile --filter=@cmumaps/server",
    "dev:panel:db": "cd apps/server && bunx prisma studio",
    "dev:panel:server": "cd apps/server && bun run dev",
    "dev:prepare": "bun ./scripts/dev/prepare.ts",
    "dev:server": "turbo dev --filter=@cmumaps/server",
    "preinstall": "bunx only-allow bun",
    "prepare": "vp config --hooks --no-agent",
    "secrets:pull": "PROJECT=cmumaps APPS='server dataflow' ENVS='applicants local dev staging prod' ./scripts/secrets/multi/pull.sh",
    "secrets:push": "PROJECT=cmumaps APPS='server dataflow' ENVS='applicants local dev staging prod' ./scripts/secrets/multi/push.sh",
    "secrets:setup": "./scripts/secrets/setup.sh",
    "start": "turbo start",
    "sync": "cd apps/server && bun run db-generate && bun run tsoa && bun run openapi",
    "syncpack": "syncpack lint",
    "syncpack:fix": "syncpack format && syncpack fix-mismatches",
    "syncpack:update": "syncpack update"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
