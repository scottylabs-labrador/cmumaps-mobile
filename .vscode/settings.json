{
  // Use zsh as the default terminal profile
  "terminal.integrated.defaultProfile.linux": "zsh",

  // Editor settings
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },

  // File associations
  "files.associations": {
    ".env.*": "properties"
  },

  // Formatters
  // Bun does not hoist oxfmt into node_modules/.bin, so the Oxc extension
  // never starts and cannot format TypeScript until this path is set.
  "oxc.path.oxfmt": "node_modules/.bun/node_modules/oxfmt/bin/oxfmt",
  "oxc.fmt.disableNestedConfig": true,
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[opentofu]": {
    "editor.defaultFormatter": "opentofu.vscode-opentofu"
  }
}
