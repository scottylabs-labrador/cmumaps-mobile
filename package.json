{
  "name": "cmumaps",
  "version": "0.0.0",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/bun": "^1.3.5",
    "syncpack": "^13.0.4",
    "turbo": "^2.7.4",
    "typescript": "^7.0.2",
    "vite-plus": "^1.8.0"
  },
  "packageManager": "bun@1.3.5",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "check": "vp check",
    "dev": "turbo dev",
    "preinstall": "bunx only-allow bun",
    "prepare": "vp config --hooks --no-agent",
    "secrets": "BAO_ADDR=https://bao.scottylabs.org bao login -method=oidc",
    "start": "turbo start",
    "sync": "cd apps/server && bun run tsoa && bun run openapi",
    "syncpack": "syncpack lint",
    "syncpack:fix": "syncpack format && syncpack fix-mismatches",
    "syncpack:update": "syncpack update"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
