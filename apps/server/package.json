{
  "name": "@cmumaps/server",
  "version": "0.0.0",
  "dependencies": {
    "@better-auth/expo": "^1.7.7",
    "@cmumaps/common": "workspace:*",
    "@cmumaps/db": "workspace:*",
    "@tsoa/runtime": "^6.6.0",
    "better-auth": "^1.7.7",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "swagger-ui-dist": "^5.31.0",
    "swagger-ui-express": "^5.0.1",
    "tinyqueue": "^3.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.9.2",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^8.0.0",
    "esbuild": "^0.25.12",
    "globals": "^16.5.0",
    "onchange": "^7.1.0",
    "tsoa": "^6.6.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  },
  "keywords": [],
  "license": "ISC",
  "scripts": {
    "build": "bun build src/server.ts --outdir=dist --target=bun --sourcemap",
    "dev": "concurrently 'bun run server' 'bun run tsoa:watch' 'bun run openapi:watch'",
    "dev:watch": "concurrently 'bun run server' 'bun run tsoa:watch' 'bun run openapi:watch'",
    "openapi": "cd ../.. && bun --filter @cmumaps/openapi-codegen openapi",
    "openapi:watch": "onchange './build/swagger.yaml' -- bun run openapi",
    "server": "secretspec run -P local -f ../../packages/db/secretspec.toml -- secretspec run -P local -- bun run --watch src/server.ts",
    "tsoa": "tsoa spec-and-routes",
    "tsoa:watch": "onchange 'src/controllers/*.ts' 'tsoa.json' -- bun run tsoa"
  },
  "type": "module"
}
